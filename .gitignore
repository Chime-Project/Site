# This repo's root is served publicly by GitHub Pages — anything committed here
# is fetchable at https://chime-project.github.io/Site/<path>. Keep local-only
# working notes and OS cruft out of the deploy.
CLAUDE.md
.DS_Store

# Source/reference material, not site assets — the deployed page uses test_vials.webp
uploads/*.pdf
uploads/test_vials.jpg

# Internal pricing/funnel docs (all-brand strategy) — never publish these
uploads/*.xlsx

# Assessment redesign proposals (Chime_Assessment_V*.pages). They carry the
# legal/compliance team's verbatim screening questions and consent names — the
# last thing that should be fetchable from the Pages root.
uploads/*.pages

# Full-resolution signals-photo masters — the site serves the 000N.webp recompressions
uploads/000[0-9].png

# Local-only dated snapshots of the site's pages, kept for reference — never deploy
reference-pages/

# Standalone handoff export of amerilean.html (folder + zip) — regenerated from
# the live files, never deployed; the repo root is the Pages root
amerilean-landing/
amerilean-landing.zip
